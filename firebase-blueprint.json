{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An e-commerce product available in the store catalog",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Product title or name",
          "minLength": 2,
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "description": "Full product description and specifications",
          "maxLength": 2000
        },
        "price": {
          "type": "number",
          "description": "Product selling price in USD"
        },
        "originalPrice": {
          "type": "number",
          "description": "Original MSRP price before discount"
        },
        "category": {
          "type": "string",
          "description": "Category slug or name",
          "maxLength": 60
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of product primary image",
          "maxLength": 1000
        },
        "stock": {
          "type": "number",
          "description": "Available stock quantity"
        },
        "rating": {
          "type": "number",
          "description": "Average review rating 1-5"
        },
        "reviewCount": {
          "type": "number",
          "description": "Total count of reviews"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether highlighted on home storefront"
        },
        "badge": {
          "type": "string",
          "description": "Promotional badge like Bestseller or Sale",
          "maxLength": 40
        }
      },
      "required": ["name", "price", "category", "imageUrl", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer purchase order with line items and shipping info",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of customer",
          "maxLength": 128
        },
        "customerEmail": {
          "type": "string",
          "description": "Email address for order confirmation",
          "maxLength": 200
        },
        "customerName": {
          "type": "string",
          "description": "Full customer name",
          "maxLength": 120
        },
        "subtotal": {
          "type": "number",
          "description": "Sum of line items before tax/shipping"
        },
        "tax": {
          "type": "number",
          "description": "Calculated sales tax"
        },
        "shipping": {
          "type": "number",
          "description": "Shipping cost"
        },
        "total": {
          "type": "number",
          "description": "Grand total paid"
        },
        "status": {
          "type": "string",
          "description": "Fulfillment status of order",
          "enum": ["pending", "processing", "shipped", "delivered", "cancelled"]
        },
        "paymentMethod": {
          "type": "string",
          "description": "Method of payment",
          "maxLength": 50
        }
      },
      "required": ["userId", "customerEmail", "customerName", "subtotal", "total", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "A customer rating and review for a product",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Product document ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Author UID",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Display name of reviewer",
          "maxLength": 100
        },
        "rating": {
          "type": "number",
          "description": "Star rating 1 to 5"
        },
        "comment": {
          "type": "string",
          "description": "Review text comment",
          "maxLength": 1000
        }
      },
      "required": ["productId", "userId", "userName", "rating", "comment"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global store configurations and business profile",
      "type": "object",
      "properties": {
        "storeName": {
          "type": "string",
          "description": "Business store name",
          "maxLength": 100
        },
        "currency": {
          "type": "string",
          "description": "Currency code",
          "maxLength": 10
        },
        "currencySymbol": {
          "type": "string",
          "description": "Currency symbol",
          "maxLength": 5
        },
        "supportEmail": {
          "type": "string",
          "description": "Support contact email",
          "maxLength": 150
        },
        "freeShippingThreshold": {
          "type": "number",
          "description": "Cart subtotal needed for free shipping"
        },
        "taxRate": {
          "type": "number",
          "description": "Sales tax rate decimal"
        },
        "bannerMessage": {
          "type": "string",
          "description": "Top announcement banner message",
          "maxLength": 300
        }
      },
      "required": ["storeName", "currency", "currencySymbol", "supportEmail"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of e-commerce catalog products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product customer reviews"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Global store profile and configuration"
    }
  }
}
